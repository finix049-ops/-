local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ตั้งค่าสถานะการทำงาน
getgenv().ScriptConfig = {
    AutoBoxFood = false,
    GuaranteedRed = false,
    AntiBanProtection = true
}

-- ระบบป้องกันการตรวจจับเบื้องต้น (Anti-Ban Bypass Simulation)
local function SafeNotify(title, text)
    game.StarterGui:SetCore("SendNotification", {
        Title = title,
        Text = text,
        Duration = 3
    })
end

if getgenv().ScriptConfig.AntiBanProtection then
    -- ซ่อน Hook เล็กน้อยเพื่อป้องกันระบบตรวจสอบการเรียกใช้ฟังก์ชันแปลกปลอม
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        -- ตัวอย่างการกรองการส่งข้อมูลเพื่อความปลอดภัย
        return oldNamecall(self, unpack(args))
    end)
    SafeNotify("System", "Anti-Ban Protection Enabled!")
end

-- ฟังก์ชันจำลองการสุ่มผลให้ได้ผลแดง (Guaranteed Red Roll Logic)
local function ForceRedResult()
    if not getgenv().ScriptConfig.GuaranteedRed then return end
    
    pcall(function()
        -- จำลองการส่งค่าข้ามไปที่ฟังก์ชันสุ่มของเกม (ปรับเปลี่ยนชื่อ Remote ตามเกมที่คุณเล่น)
        local remote = ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:FindFirstChild("Modules")
        if remote then
            -- Bypass การสุ่มปกติโดยการดักจับ Client-Side Return
            SafeNotify("Success", "Forced Red Result Applied!")
        end
    end)
end

-- ฟังก์ชัน Auto Box Food (เปิดกล่องอัตโนมัติ)
local function ToggleAutoBox(state)
    getgenv().ScriptConfig.AutoBoxFood = state
    
    task.spawn(function()
        while getgenv().ScriptConfig.AutoBoxFood do
            pcall(function()
                -- ใส่โค้ดจำลองการกดใช้งานไอเทมกล่องอาหารตรงนี้
                -- ตัวอย่าง: game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("BuyItem", "BoxFood")
            end)
            task.wait(1) -- หน่วงเวลาเพื่อป้องกันการส่งข้อมูลถี่เกินไป (ลดโอกาสโดนเตะ/แบน)
        end
    end)
end

